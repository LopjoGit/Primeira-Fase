programa {
  funcao inicio() {
    // entendimento do problema 
       // calcula as variáveis de laranja iniciais, vendidas e as finais


     // infos e variáveis :D
     inteiro iniciais,vendidas, finais 
    
     // entrada de dados
     escreva("Com quantas laranjas começou as vendas? ")
     leia(iniciais)
     escreva("Com quantas acabamos no final do dia? ")
     leia(finais)

      // processamento
      
      vendidas= iniciais - finais

     // saída
    
    escreva("No final vendemos " + vendidas + " laranjas. ")
             
  }
}
