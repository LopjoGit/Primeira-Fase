programa {
  funcao inicio() {
   // entendimento do problema
    // calcular o horario de retorno do recreio 

   // info e variaveis
   inteiro hora, minuto 
   //entrada de dados
   escreva("Hora do começo: ")
   leia(hora)
   escreva("Minuto do começo: ")
   leia(minuto)
   //processamento
   minuto = minuto + 20 
   //saida
   escreva("Recreio termina ")
   escreva(hora)
   escreva(":")
   escreva(minuto)
   
  //  escreva(" O que acontece com quem chega depois do horario? ")


  }
}